# App Configuration
# The public URL of your application (required for Better Auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth Configuration
# Generate a secure random string (at least 32 characters)
# You can use: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here-change-this-in-production

# Database Configuration
# SQLite database file path (relative to project root)
DATABASE_URL=./sqlite.db

# Overleaf CE Integration
# Docker socket path for container communication
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Sharelatex container name (default: sharelatex)
SHARELATEX_CONTAINER=sharelatex

# MongoDB connection URL (exposed from Docker)
MONGODB_URL=mongodb://localhost:27017/sharelatex

# Redis connection URL (exposed from Docker)
REDIS_URL=redis://localhost:6379

# Path to overleaf-toolkit directory (optional)
OVERLEAF_TOOLKIT_PATH=../docker/overleaf-toolkit

# Environment
# Set to "production" in production
NODE_ENV=development

# Skip environment validation (useful for build-time)
# SKIP_ENV_VALIDATION=true